# Example settings only. Never commit your filled-in configuration.
# Load manually: set -a; source .env.archive; set +a
IMAP_SOURCE_HOST=imap.source.example
IMAP_TARGET_HOST=imap.destination.example
IMAP_SOURCE_USER=source_user@example.invalid
IMAP_TARGET_USER=archive@example.invalid
IMAP_SOURCE_INBOX_FOLDER=INBOX
IMAP_TARGET_INBOX_FOLDER=INBOX
IMAP_SOURCE_SENT_FOLDER=Sent
IMAP_TARGET_SENT_FOLDER="Sent Items"
IMAP_MIGRATION_ROOT=$HOME/private-mail/migration-state
IMAP_AUDIT_ROOT=$HOME/private-mail/audit
IMAP_OAUTH_HELPER=$HOME/private-mail/oauth_refresh.py
IMAP_OAUTH_WRAPPER=$HOME/private-mail/orchestrator.py
IMAP_OAUTH_TOKEN=$HOME/private-mail/access_token.txt
