# Synthetic examples only. Copy to a private .env and customize locally.
# The program reads environment variables; it does not load .env itself.
IMAP_SOURCE_HOST="imap.example.org"
IMAP_SOURCE_USER="source@example.org"
IMAP_TARGET_HOST="outlook.office365.com"
IMAP_TARGET_USER="archive@example.org"
IMAP_WORK_DIR="$HOME/.local/state/imapsync-orchestrator"
IMAP_OAUTH_REFRESH_SCRIPT="/absolute/private/path/oauth_refresh.py"
IMAP_ACCESS_TOKEN_FILE="/absolute/private/path/access_token.txt"
# Optional: set IMAP_PYTHON to the interpreter used by the OAuth helper.
# No passwords or access tokens belong in this example file.
